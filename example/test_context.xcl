# Minimal test for context blocks

# Test 1: Simple context block
cloudflare "my-account" {
    print "inside cloudflare"
}

# Test 2: Context block with assignment
cloudflare "my-account" {
    $config = cloudflare.config
    print $config
}

# Test 3: Nested context block
cloudflare "my-account" {
    bucket "my-bucket" {
        $objects = bucket.list ""
    }
}

# Test 4: Context block with if
cloudflare "my-account" {
    if true {
        print "inside if"
    }
}

# Test 5: Context block with for
cloudflare "my-account" {
    for $item in [1, 2, 3] {
        print $item
    }
}

print "All tests passed"
