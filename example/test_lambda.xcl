# Minimal lambda test — pipe style only

# Test pipe lambda — single param
$double = |$x| $x * 2
print $double

# Test pipe lambda with multiple params
$add = |$a, $b| $a + $b
print $add

# Test pipe lambda — another example
$quad = |$x| $x * 4
print $quad

# Test in function call
$arr = [1, 2, 3]
$result = collections.map $arr |$x| $x * 2
print $result

print "Lambda tests passed"
