# Context blocks
cloudflare "my-account" {
    $config = cloudflare.config
    $buckets = bucket.list ""
    $dns = api.list "dns/records"
    bucket "my-bucket" {
        $objects = bucket.list ""
        $put = bucket.put "file.txt" "content"
    }
}
domain.run "bucket.name" "xcl-test" {
    $list = bucket.list ""
    $put = bucket.put "hello.txt" "Hello!"
}

# Security policy
sec.policy {
    allow file.read "/data/"
    allow network.connect "api.cloudflare.com"
    deny process.exec
    limit memory 512mb
    limit cpu_time 60s
}

# Error handling
$op = io.file.read "config.json"
if $op.is_ok {
    $data = $op.value
    $parsed = json.parse $data
    print "Loaded config"
}
if $op.is_err {
    print "Error:" $op.error.message
    sys.exit 1
}

# Blocks
$result = {
    $temp = 10 + 20
    $temp * 2
}
{
    $local = "only visible here"
    print $local
}

# Deploy function
deploy($account, $domain) {
    $env = io.read_env ".env"
    if $env.is_err {
        print "FATAL: Missing .env"
        return none
    }
    sec.policy {
        allow file.read "/data/"
        allow network.connect "api.cloudflare.com"
        deny process.exec
        limit memory 512mb
    }
    cloudflare $account {
        $dns = api.list "dns/records"
        if $dns.is_ok {
            $matching = collections.filter $dns.value {
                |$record| $record.name == $domain
            }
            if collections.array_len $matching > 0 {
                $record = collections.array_get $matching 0
                print "Updating:" $record.id
            }
        }
        $code = """
            addEventListener('fetch', event => {
                event.respondWith(new Response('Hello!'));
            });
        """
        $deploy = function.deploy "my-worker" $code
        $analytics = api.request "analytics/query" {
            since: "-1h"
            until: "now"
        }
        if $analytics.is_ok {
            $data = $analytics.value
            print "Requests:" $data.requests
            print "Threats:" $data.threats
        }
    }
    $report = text.format "Deployed to {}" $domain
    io.file.write "/data/output/report.txt" $report
    print $report
}
deploy "my-account" "app.example.com"
