# OCI (Oracle Cloud Infrastructure) provider example
# Tests domain expansion, config, and credentials

# Basic OCI context
oci "my-tenancy" {
    $config = oci.config ()
    print "OCI tenancy:" $config.tenancy
}

# OCI credentials from environment
oci "my-tenancy" {
    $creds = oci.credential ()
    print "OCI credentials loaded"
}

# Nested OCI tenancies
oci "tenancy-a" {
    oci "tenancy-b" {
        $config = oci.config ()
        print "Nested tenancy:" $config.tenancy
    }
    $config = oci.config ()
    print "Restored tenancy:" $config.tenancy
}

# OCI with bucket context (via domain.get)
oci "my-tenancy" {
    domain.run "bucket.name" "my-test-bucket" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "OCI example complete"
