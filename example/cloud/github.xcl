# GitHub provider example
# Tests domain expansion, config, and credentials

# Basic GitHub context
github "my-org" {
    $config = github.config ()
    print "GitHub org:" $config.org
}

# GitHub credentials from environment
github "my-org" {
    $creds = github.credential ()
    print "GitHub credentials loaded"
}

# Nested GitHub orgs
github "org-a" {
    github "org-b" {
        $config = github.config ()
        print "Nested org:" $config.org
    }
    $config = github.config ()
    print "Restored org:" $config.org
}

# GitHub with bucket context (via domain.get)
github "my-org" {
    domain.run "bucket.name" "my-repo" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "GitHub example complete"
