# AWS provider example
# Tests domain expansion, config, and credentials
#
# SECURITY: Never hardcode API tokens or credentials in your XCL scripts.
# Always load them from a .env file using io.read_env.
#
# Create a .env file with your credentials:
#   AWS_ACCESS_KEY_ID=your-access-key-here
#   AWS_SECRET_ACCESS_KEY=your-secret-key-here

# Load credentials securely from .env
$envResult = io.read_env ".env"
if $envResult.is_ok {
    $env = $envResult.value
    $accessKey = $env.AWS_ACCESS_KEY_ID
    $secretKey = $env.AWS_SECRET_ACCESS_KEY
    print "AWS credentials loaded from .env"
}
if $envResult.is_err {
    print "Warning: could not load .env file:" $envResult.message
}

# Basic AWS context
aws "us-east-1" {
    $config = aws.config ()
    print "AWS region:" $config.region
}

# AWS credentials from environment
aws "us-east-1" {
    $creds = aws.credential ()
    print "AWS credentials loaded"
}

# AWS SigV4 signing test
aws "us-east-1" {
    $signed = aws.sign "GET" "https://s3.amazonaws.com/" ""
    print "AWS SigV4 signing works"
}

# Nested AWS regions
aws "us-east-1" {
    aws "eu-west-1" {
        $config = aws.config ()
        print "Nested region:" $config.region
    }
    $config = aws.config ()
    print "Restored region:" $config.region
}

# AWS with bucket context (via domain.get)
aws "us-east-1" {
    domain.run "bucket.name" "my-test-bucket" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "AWS example complete"
