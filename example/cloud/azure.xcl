# Azure provider example
# Tests domain expansion, config, and credentials

# Basic Azure context
azure "my-subscription" {
    $config = azure.config ()
    print "Azure subscription:" $config.subscription
}

# Azure credentials from environment
azure "my-subscription" {
    $creds = azure.credential ()
    print "Azure credentials loaded"
}

# Nested Azure subscriptions
azure "sub-a" {
    azure "sub-b" {
        $config = azure.config ()
        print "Nested subscription:" $config.subscription
    }
    $config = azure.config ()
    print "Restored subscription:" $config.subscription
}

# Azure with bucket context (via domain.get)
azure "my-subscription" {
    domain.run "bucket.name" "my-test-bucket" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "Azure example complete"
