# Cloudflare provider example
# Tests domain expansion, credentials, and all service operations
#
# SECURITY: Never hardcode API tokens or credentials in your XCL scripts.
# Always load them from a .env file using io.read_env.
#
# Create a .env file with your credentials:
#   CLOUDFLARE_API_TOKEN=your-api-token-here
#   CLOUDFLARE_ACCOUNT=your-account-id-here

# Load credentials securely from .env
$envResult = io.read_env ".env"
if $envResult.is_ok {
    $env = $envResult.value
    $token = $env.CLOUDFLARE_API_TOKEN
    $account = $env.CLOUDFLARE_ACCOUNT
    print "Cloudflare credentials loaded from .env"
}
if $envResult.is_err {
    print "Warning: could not load .env file:" $envResult.message
}

# Basic Cloudflare context — account auto-loaded from .env
cloudflare "" {
    $config = cloudflare.config
    print "Cloudflare account:" $config.account
}

# Nested Cloudflare accounts
cloudflare "acc-a" {
    cloudflare "acc-b" {
        $config = cloudflare.config
        print "Nested account:" $config.account
    }
    $config = cloudflare.config
    print "Restored account:" $config.account
}

# R2 bucket operations — account auto-loaded from .env
cloudflare "" {
    # Create a new R2 bucket
    $create = bucket.create "xcl-test-bucket"
    if $create.is_ok {
        print "Bucket created successfully"
    }
    if $create.is_err {
        print "Bucket create error (may already exist):" $create.error.message
    }

    # List, put, get, delete objects
    domain.run "bucket.name" "xcl-test-bucket" {
        $list = bucket.list ""
        if $list.is_ok {
            print "Bucket list: OK"
        }
        if $list.is_err {
            print "Bucket list error:" $list.error.message
        }

        $put = bucket.put "hello.txt" "Hello from XCL!"
        if $put.is_ok {
            print "Bucket put: OK"
        }
        if $put.is_err {
            print "Bucket put error:" $put.error.message
        }

        $get = bucket.get "hello.txt"
        if $get.is_ok {
            print "Bucket get: OK"
        }
        if $get.is_err {
            print "Bucket get error:" $get.error.message
        }

        $del = bucket.delete "hello.txt"
        if $del.is_ok {
            print "Bucket delete: OK"
        }
        if $del.is_err {
            print "Bucket delete error:" $del.error.message
        }
    }

    # Workers function operations
    $workers = function.list
    if $workers.is_ok {
        print "Workers list: OK"
    }
    if $workers.is_err {
        print "Workers list error:" $workers.error.message
    }

    # Durable Objects operations
    $instances = instance.list
    if $instances.is_ok {
        print "Instances list: OK"
    }
    if $instances.is_err {
        print "Instances list error:" $instances.error.message
    }

    # =============================================
    # Generic API Gateway — Access all 15+ API categories
    # =============================================
    # The api.* functions provide access to any Cloudflare API endpoint
    # without dedicated service modules. This covers all categories:
    # DNS, AI, KV, D1, Queues, Zones, SSL, Load Balancers, and more.

    # --- DNS Records (Category: DNS) ---
    # List DNS records
    $dnsList = api.list "dns/records"
    if $dnsList.is_ok {
        print "DNS records list: OK"
    }
    if $dnsList.is_err {
        print "DNS records list error:" $dnsList.error.message
    }

    # Create a DNS record
    $dnsCreate = api.create "dns/records" {
        api.body "{\"type\":\"A\",\"name\":\"example.com\",\"content\":\"1.2.3.4\",\"ttl\":3600}"
    }
    if $dnsCreate.is_ok {
        print "DNS record created: OK"
    }
    if $dnsCreate.is_err {
        print "DNS record create error:" $dnsCreate.error.message
    }

    # --- AI Inference (Category: AI) ---
    # Run an AI model via Workers AI
    $aiResult = api.request "ai/run/@cf/meta-llama/llama-2-7b-chat-int8" {
        api.method "POST"
        api.body "{\"prompt\":\"Hello from XCL!\"}"
    }
    if $aiResult.is_ok {
        print "AI model inference: OK"
    }
    if $aiResult.is_err {
        print "AI model inference error:" $aiResult.error.message
    }

    # --- Workers KV (Category: Storage & Databases) ---
    # List KV namespaces
    $kvList = api.list "workers/kv/namespaces"
    if $kvList.is_ok {
        print "KV namespaces list: OK"
    }
    if $kvList.is_err {
        print "KV namespaces list error:" $kvList.error.message
    }

    # Create a KV namespace
    $kvCreate = api.create "workers/kv/namespaces" {
        api.body "{\"title\":\"xcl-test-kv\"}"
    }
    if $kvCreate.is_ok {
        print "KV namespace created: OK"
    }
    if $kvCreate.is_err {
        print "KV namespace create error:" $kvCreate.error.message
    }

    # --- D1 Databases (Category: Storage & Databases) ---
    # List D1 databases
    $d1List = api.list "d1/databases"
    if $d1List.is_ok {
        print "D1 databases list: OK"
    }
    if $d1List.is_err {
        print "D1 databases list error:" $d1List.error.message
    }

    # Create a D1 database
    $d1Create = api.create "d1/databases" {
        api.body "{\"name\":\"xcl-test-db\"}"
    }
    if $d1Create.is_ok {
        print "D1 database created: OK"
    }
    if $d1Create.is_err {
        print "D1 database create error:" $d1Create.error.message
    }

    # --- Zone Management (Category: Domain/Zone Management) ---
    # List zones
    $zonesList = api.list "zones"
    if $zonesList.is_ok {
        print "Zones list: OK"
    }
    if $zonesList.is_err {
        print "Zones list error:" $zonesList.error.message
    }

    # --- Workers Queues (Category: Workers & Pages) ---
    # List queues
    $queuesList = api.list "queues"
    if $queuesList.is_ok {
        print "Queues list: OK"
    }
    if $queuesList.is_err {
        print "Queues list error:" $queuesList.error.message
    }

    # --- Load Balancers (Category: Networking) ---
    # List load balancers
    $lbsList = api.list "load_balancers"
    if $lbsList.is_ok {
        print "Load balancers list: OK"
    }
    if $lbsList.is_err {
        print "Load balancers list error:" $lbsList.error.message
    }

    # --- SSL/TLS Certificates (Category: Certificate Management) ---
    # List origin CA certificates
    $sslList = api.list "ssl/origin_ca_certificates"
    if $sslList.is_ok {
        print "SSL certificates list: OK"
    }
    if $sslList.is_err {
        print "SSL certificates list error:" $sslList.error.message
    }

    # --- Account Members (Category: Account & User Management) ---
    # List account members
    $membersList = api.list "members"
    if $membersList.is_ok {
        print "Account members list: OK"
    }
    if $membersList.is_err {
        print "Account members list error:" $membersList.error.message
    }

    # --- API Request with custom method (DELETE example) ---
    # Delete a resource by ID
    $deleteResult = api.request "dns/records/record-id-to-delete" {
        api.method "DELETE"
    }
    if $deleteResult.is_ok {
        print "Delete request: OK"
    }
    if $deleteResult.is_err {
        print "Delete request error:" $deleteResult.error.message
    }

    # --- API Deploy (PUT/PATCH example) ---
    # Update a DNS record
    $deployResult = api.deploy "dns/records/record-id" {
        api.body "{\"content\":\"5.6.7.8\"}"
    }
    if $deployResult.is_ok {
        print "Deploy update: OK"
    }
    if $deployResult.is_err {
        print "Deploy update error:" $deployResult.error.message
    }

    # --- Vectorize (Category: Storage & Databases) ---
    # List Vectorize indexes
    $vectorizeList = api.list "vectorize/indexes"
    if $vectorizeList.is_ok {
        print "Vectorize indexes list: OK"
    }
    if $vectorizeList.is_err {
        print "Vectorize indexes list error:" $vectorizeList.error.message
    }

    # --- Pages (Category: Workers & Pages) ---
    # List Pages projects
    $pagesList = api.list "pages/projects"
    if $pagesList.is_ok {
        print "Pages projects list: OK"
    }
    if $pagesList.is_err {
        print "Pages projects list error:" $pagesList.error.message
    }

    # --- WAF Rulesets (Category: Rules) ---
    # List rulesets
    $rulesetsList = api.list "rulesets"
    if $rulesetsList.is_ok {
        print "Rulesets list: OK"
    }
    if $rulesetsList.is_err {
        print "Rulesets list error:" $rulesetsList.error.message
    }

    # --- Turnstile (Category: Security) ---
    # List Turnstile widgets
    $turnstileList = api.list "turnstile/widgets"
    if $turnstileList.is_ok {
        print "Turnstile widgets list: OK"
    }
    if $turnstileList.is_err {
        print "Turnstile widgets list error:" $turnstileList.error.message
    }

    # --- Analytics (Category: Observability) ---
    # Query analytics data
    $analyticsResult = api.request "analytics/query" {
        api.params { since: "-24h", until: "now" }
    }
    if $analyticsResult.is_ok {
        print "Analytics query: OK"
    }
    if $analyticsResult.is_err {
        print "Analytics query error:" $analyticsResult.error.message
    }

    # --- Tunnels (Category: Cloudflare One) ---
    # List Cloudflare Tunnel connections
    $tunnelsList = api.list "cfd_tunnel"
    if $tunnelsList.is_ok {
        print "Tunnels list: OK"
    }
    if $tunnelsList.is_err {
        print "Tunnels list error:" $tunnelsList.error.message
    }
}

print "Cloudflare example complete"
