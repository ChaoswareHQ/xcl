# GCP provider example
# Tests domain expansion, config, and credentials

# Basic GCP context
gcp "my-project" {
    $config = gcp.config ()
    print "GCP project:" $config.project
}

# GCP credentials from environment
gcp "my-project" {
    $creds = gcp.credential ()
    print "GCP credentials loaded"
}

# Nested GCP projects
gcp "project-a" {
    gcp "project-b" {
        $config = gcp.config ()
        print "Nested project:" $config.project
    }
    $config = gcp.config ()
    print "Restored project:" $config.project
}

# GCP with bucket context (via domain.get)
gcp "my-project" {
    domain.run "bucket.name" "my-test-bucket" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "GCP example complete"
