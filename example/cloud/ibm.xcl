# IBM Cloud provider example
# Tests domain expansion, config, and credentials

# Basic IBM context
ibm "my-account" {
    $config = ibm.config ()
    print "IBM account:" $config.account
}

# IBM credentials from environment
ibm "my-account" {
    $creds = ibm.credential ()
    print "IBM credentials loaded"
}

# Nested IBM accounts
ibm "acc-a" {
    ibm "acc-b" {
        $config = ibm.config ()
        print "Nested account:" $config.account
    }
    $config = ibm.config ()
    print "Restored account:" $config.account
}

# IBM with bucket context (via domain.get)
ibm "my-account" {
    domain.run "bucket.name" "my-test-bucket" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "IBM example complete"
