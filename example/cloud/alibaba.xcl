# Alibaba Cloud provider example
# Tests domain expansion, config, and credentials

# Basic Alibaba context
alibaba "my-account" {
    $config = alibaba.config ()
    print "Alibaba account:" $config.account
}

# Alibaba credentials from environment
alibaba "my-account" {
    $creds = alibaba.credential ()
    print "Alibaba credentials loaded"
}

# Nested Alibaba accounts
alibaba "acc-a" {
    alibaba "acc-b" {
        $config = alibaba.config ()
        print "Nested account:" $config.account
    }
    $config = alibaba.config ()
    print "Restored account:" $config.account
}

# Alibaba with bucket context (via domain.get)
alibaba "my-account" {
    domain.run "bucket.name" "my-test-bucket" {
        $bucket = domain.get "bucket.name"
        print "Bucket context:" $bucket
    }
}

print "Alibaba example complete"
