# Test: POST request with JSON body
# Tests: https.post, JSON response parsing, response.json field

$response = https.post "https://httpbin.org/post" '{"name":"Alice","age":30}' none
print "POST Status:" $response.status
print "POST OK:" $response.ok

# Check auto-parsed JSON
if $response.json != none {
    print "PASS: JSON auto-parsed"
    print "JSON type:" type $response.json
}

# Check body contains our data
print "Body length:" $response.content_length
