# native_call: one builtin call per iteration.
#
# `print` (with no arguments) is a native declared `hot`, so this loop measures
# the `OP_CALL_HOT` path against the other languages' builtin calls (`type`,
# `isinstance`), not map/array work.
$i = 0
while $i < 2000000 {
    print
    $i = $i + 1
}
print $i
